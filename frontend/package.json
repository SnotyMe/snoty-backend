{
	"name": "snoty-frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"preview": "nuxt preview",
		"generate": "nuxt generate",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"typecheck": "nuxt typecheck",
		"fetch-api-spec:backend": "curl -o ./app/api/backend/openapi.json http://localhost:8080/api/openapi.json",
		"generate:api": "export TS_POST_PROCESS_FILE=app/api/post-process.sh && for dir in app/api/*/; do openapi-generator-cli generate -c \"$dir/openapi-config.yml\" --skip-validate-spec --enable-post-process-file & done; wait; app/api/patch.sh"
	},
	"dependencies": {
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-liquid": "^6.3.2",
		"@nuxt/ui": "^4.11.0",
		"@nuxtjs/eslint-module": "4.1.0",
		"@nuxtjs/i18n": "^10.4.1",
		"@nuxtjs/robots": "5.7.0",
		"@pinia/nuxt": "^1.0.1",
		"@scalar/api-reference": "1.62.5",
		"@uiw/codemirror-theme-dracula": "^4.25.11",
		"@uiw/codemirror-theme-github": "^4.25.11",
		"@vue-flow/background": "^1.3.2",
		"@vue-flow/controls": "^1.1.3",
		"@vue-flow/core": "^1.48.2",
		"@vue-flow/node-resizer": "^1.5.1",
		"@vueuse/core": "^14.4.0",
		"@vueuse/nuxt": "^14.4.0",
		"@vueuse/router": "^14.4.0",
		"cronstrue": "^3.21.0",
		"elkjs": "^0.11.1",
		"eventsource": "^4.1.0",
		"jwt-decode": "^4.0.0",
		"nuxt": "^4.5.2",
		"nuxt-codemirror": "0.0.20",
		"tailwindcss": "^4.3.1",
		"wrangler": "^4.123.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.125",
		"@iconify-json/simple-icons": "^1.2.87",
		"@nuxt/eslint": "^1.16.0",
		"@nuxt/icon": "^2.2.4",
		"@openapitools/openapi-generator-cli": "^2.39.0",
		"eslint": "^10.5.0",
		"eslint-plugin-jsonc": "^2.21.1",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.5"
	},
	"packageManager": "pnpm@10.29.2"
}
